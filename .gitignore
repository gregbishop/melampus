# Environments and build artefacts
.venv/
__pycache__/
*.egg-info/
build/
dist/
# The executable copied into the plugin folder for Lightroom to run (card #401)
plugin/Melampus.lrplugin/melampus
plugin/Melampus.lrplugin/melampus.exe

# Photo corpora — large binary, not source, at any depth (card #441). No trailing
# slash: a checkout may borrow the corpus through a symlink named fixtures, which
# a directory-only rule would not match. The one exception is re-included after:
# service/tests/fixtures/ holds the one committed frame the binary smoke test
# analyzes. The negation works because only that folder is excluded, not its
# parent (gitignore: "It is not possible to re-include a file if a parent
# directory of that file is excluded").
fixtures
fixtures_full
!/service/tests/fixtures

# Local secrets — API tokens. Never commit.
melampus.local.toml

# Result cache (regenerable, keyed on content hash)
.melampus_cache/

# Archived earlier attempt
_old/

.DS_Store

# Generated run artifacts — regenerable, and review.html embeds photo thumbnails
review.html
*_corrections.json
fixtures_full_labels.json
stage1_*.json
plugin_results.json
stage1_*.log

# The local layer: what is true of this machine and not another, never committed.
# on-purpose's install outputs: .claude/settings.json holds the marketplace's
# absolute path; .agents/skills holds symlinks into the checkout; .codex/agents
# holds Codex agent TOML generated from the plugins' agent markdown. All three
# are regenerated by the installer; see AGENTS.md. .agents/on-purpose.json
# records the plugin choice.
# .agents/on-purpose.local.md holds this repo's private specifics (the installer
# seeds it from each plugin's template; the contents are yours), and
# .claude/settings.local.json is Claude Code's own per-user overrides.
.claude/settings.json
.agents/skills/
.codex/agents/
.agents/on-purpose.local.md
.claude/settings.local.json
