# Environments and build artefacts
.venv/
__pycache__/
*.egg-info/
build/
dist/

# Photo corpora — large binary, not source
fixtures/
fixtures_full/

# Local secrets — API tokens. Never commit.
melampus.local.toml

# Result cache (regenerable, keyed on content hash)
.melampus_cache/

# Archived earlier attempt
_old/

.DS_Store

# Generated run artifacts — regenerable, and review.html embeds photo thumbnails
review.html
*_corrections.json
fixtures_full_labels.json
stage1_*.json
plugin_results.json
stage1_*.log

# on-purpose install outputs are machine-local: the links and the marketplace path
# point into the on-purpose checkout by absolute path. .agents/on-purpose.json
# records the plugin choice; the installer regenerates the rest.
.claude/settings.json
.claude/settings.local.json
.agents/skills/
.codex/agents/
.agents/on-purpose.local.md
